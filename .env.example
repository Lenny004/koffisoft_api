NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://localhost:5432/koffisoft_local
SHADOW_DATABASE_URL=postgresql://localhost:5432/koffisoft_shadow
DATABASE_CONNECT_ON_BOOT=false
CORS_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
COOKIE_SECURE=false
SESSION_COOKIE_NAME=koffisoft_session
MFA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
MFA_KEY_VERSION=1
MFA_REQUIRED_ROLES=owner,admin,manager
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCK_MINUTES=15
TEST_DATABASE_URL=postgresql://localhost:5432/koffisoft_test
BACKUP_ENABLED=false
BACKUP_STORAGE_ROOT=./var/backups
UPLOADS_DIRECTORY=./uploads
PG_DUMP_PATH=pg_dump
TAR_PATH=tar
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_SIZE_BYTES=53687091200
BACKUP_SCHEDULE_MINUTES=0
MAILER_TRANSPORT=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Koffi-Soft" <no-reply@koffisoft.example.invalid>
