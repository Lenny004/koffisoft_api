{
  "name": "koffisoft-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": "24.13.0",
    "pnpm": "11.1.3"
  },
  "scripts": {
    "build": "pnpm run prisma:generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev --config ./prisma.config.ts",
    "db:deploy": "prisma migrate deploy --config ./prisma.config.ts",
    "db:seed": "prisma db execute --config ./prisma.config.ts --file ./prisma/seed/seed.sql",
    "db:reset": "prisma migrate reset --config ./prisma.config.ts",
    "prisma:generate": "prisma generate --config ./prisma.config.ts",
    "prisma:validate": "prisma validate --config ./prisma.config.ts",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "auth:create-user": "tsx scripts/auth-create-user.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.5",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "otplib": "13.5.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "12.1.2",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  }
}
