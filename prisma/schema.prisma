  status              OrderStatus     @default(Open)
  currency            String          @default("USD") @db.Char(3)
  subtotalAmount      Decimal         @map("subtotal_amount") @default(0) @db.Decimal(14, 2)
  discountAmount      Decimal         @map("discount_amount") @default(0) @db.Decimal(14, 2)
  taxAmount           Decimal         @map("tax_amount") @default(0) @db.Decimal(14, 2)
  serviceChargeAmount Decimal         @map("service_charge_amount") @default(0) @db.Decimal(14, 2)
  tipAmount           Decimal         @map("tip_amount") @default(0) @db.Decimal(14, 2)
  totalAmount         Decimal         @map("total_amount") @default(0) @db.Decimal(14, 2)
  balanceDue          Decimal         @map("balance_due") @default(0) @db.Decimal(14, 2)
  notes               String?         @db.Text
  openedAt            DateTime        @map("opened_at") @default(now()) @db.Timestamptz(3)
  closedAt            DateTime?       @map("closed_at") @db.Timestamptz(3)
  createdAt           DateTime        @map("created_at") @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime        @map("updated_at") @default(now()) @db.Timestamptz(3)

  location       Location            @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  customer       Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  reservation    Reservation?        @relation("ReservationOrders", fields: [reservationId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  event          Event?              @relation("EventOrders", fields: [eventId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  serverEmployee Employee?           @relation("OrderServerEmployee", fields: [serverEmployeeId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  tables         OrderTableAssignment[]
  lines          OrderLine[]
  adjustments    OrderAdjustment[]
  kitchenTickets KitchenTicket[]
  payments       Payment[]            @relation("OrderPayments")
  tip            Tip?
  dteDocuments  DteDocument[]

  @@unique([locationId, orderNumber], map: "orders_number_unique")
  @@index([locationId, businessDate, status], map: "orders_location_date_status_idx")
  @@index([customerId, openedAt(sort: Desc)], map: "orders_customer_idx")
  /// Totales, cierre y fecha comercial tienen CHECK/lógica de aplicación.
  @@map("orders")
}

/// Mesas asociadas a una orden.
model OrderTableAssignment {
  orderId       String   @map("order_id") @db.Uuid
  diningTableId String   @map("dining_table_id") @db.Uuid
  isPrimary     Boolean  @map("is_primary") @default(false)
  assignedAt    DateTime @map("assigned_at") @default(now()) @db.Timestamptz(3)

  order       Order       @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  diningTable DiningTable @relation(fields: [diningTableId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  /// El índice parcial de una sola mesa primaria vive en SQL.
  @@id([orderId, diningTableId])
  @@map("order_table_assignments")
}

/// Línea de venta con snapshots históricos.
model OrderLine {
  id                  String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId             String          @map("order_id") @db.Uuid
  lineNo              Int             @map("line_no") @db.SmallInt
  menuItemVariantId   String?         @map("menu_item_variant_id") @db.Uuid
  recipeId            String?         @map("recipe_id") @db.Uuid
  itemNameSnapshot    String          @map("item_name_snapshot") @db.VarChar(200)
  variantNameSnapshot String          @map("variant_name_snapshot") @db.VarChar(120)
  skuSnapshot         String          @map("sku_snapshot") @db.VarChar(60)
  quantity            Decimal         @db.Decimal(14, 6)
  unitPrice           Decimal         @map("unit_price") @db.Decimal(14, 2)
  includesTax         Boolean         @map("includes_tax") @default(true)
  taxRate             Decimal         @map("tax_rate") @default(0) @db.Decimal(7, 6)
  grossAmount         Decimal         @map("gross_amount") @db.Decimal(14, 2)
  discountAmount      Decimal         @map("discount_amount") @default(0) @db.Decimal(14, 2)
  taxableAmount       Decimal         @map("taxable_amount") @db.Decimal(14, 2)
  taxAmount           Decimal         @map("tax_amount") @db.Decimal(14, 2)
  totalAmount         Decimal         @map("total_amount") @db.Decimal(14, 2)
  status              OrderLineStatus @default(Open)
  specialInstructions String?         @map("special_instructions") @db.Text
  createdAt           DateTime        @map("created_at") @default(now()) @db.Timestamptz(3)

  order             Order             @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  menuItemVariant   MenuItemVariant?  @relation(fields: [menuItemVariantId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  recipe            Recipe?           @relation(fields: [recipeId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  modifiers         OrderLineModifier[]
  kitchenTicketLines KitchenTicketLine[]
  dteDocumentLines  DteDocumentLine[]
  inventoryMovements InventoryMovement[]

  @@unique([orderId, lineNo], map: "order_lines_number_unique")
  @@index([orderId], map: "order_lines_order_idx")
  /// Importes, descuentos y conciliación de línea son CHECK de SQL.
  @@map("order_lines")
}

/// Modificador elegido para una línea de orden.
model OrderLineModifier {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderLineId String   @map("order_line_id") @db.Uuid
  modifierId  String?  @map("modifier_id") @db.Uuid
  nameSnapshot String  @map("name_snapshot") @db.VarChar(120)
  quantity    Decimal  @default(1) @db.Decimal(14, 6)
  priceDelta  Decimal  @map("price_delta") @default(0) @db.Decimal(14, 2)
  totalDelta  Decimal  @map("total_delta") @default(0) @db.Decimal(14, 2)
  notes       String?  @db.Text

  orderLine OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  modifier  Modifier? @relation(fields: [modifierId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  /// total_delta = round(quantity * price_delta, 2) es CHECK de SQL.
  @@map("order_line_modifiers")
}

/// Descuento o cargo de servicio aplicado a una orden.
model OrderAdjustment {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  adjustmentType String   @map("adjustment_type") @db.VarChar(20)
  description    String   @db.VarChar(200)
  rate           Decimal? @db.Decimal(7, 6)
  amount         Decimal  @db.Decimal(14, 2)
  promotionId    String?  @map("promotion_id") @db.Uuid
  createdByUserId String? @map("created_by_user_id") @db.Uuid
  createdAt      DateTime @map("created_at") @default(now()) @db.Timestamptz(3)

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  promotion Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  creator   User?      @relation("OrderAdjustmentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  /// adjustment_type, rate y amount son CHECK de SQL.
  @@map("order_adjustments")
}

/// Comanda enviada a una estación específica.
model KitchenTicket {
  id            String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId       String              @map("order_id") @db.Uuid
  prepStationId String              @map("prep_station_id") @db.Uuid
  ticketNumber  Int                 @map("ticket_number")
  status        KitchenTicketStatus  @default(Queued)
  sentAt        DateTime             @map("sent_at") @default(now()) @db.Timestamptz(3)
  startedAt     DateTime?            @map("started_at") @db.Timestamptz(3)
  readyAt       DateTime?            @map("ready_at") @db.Timestamptz(3)
  servedAt      DateTime?            @map("served_at") @db.Timestamptz(3)
  notes         String?              @db.Text

  order       Order              @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  prepStation PrepStation        @relation(fields: [prepStationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lines       KitchenTicketLine[]

  @@unique([orderId, ticketNumber], map: "kitchen_tickets_number_unique")
  @@index([prepStationId, status, sentAt], map: "kitchen_tickets_station_status_idx")
  @@map("kitchen_tickets")
}

/// Línea de una comanda de cocina o barra.
model KitchenTicketLine {
  id                  String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  kitchenTicketId     String              @map("kitchen_ticket_id") @db.Uuid
  orderLineId         String              @map("order_line_id") @db.Uuid
  itemNameSnapshot    String              @map("item_name_snapshot") @db.VarChar(200)
  quantity            Decimal             @db.Decimal(14, 6)
  modifiersSnapshot   String?             @map("modifiers_snapshot") @db.Text
  specialInstructions String?             @map("special_instructions") @db.Text
  status              KitchenTicketStatus  @default(Queued)
  createdAt           DateTime            @map("created_at") @default(now()) @db.Timestamptz(3)

  kitchenTicket KitchenTicket @relation(fields: [kitchenTicketId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  orderLine     OrderLine     @relation(fields: [orderLineId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  /// quantity positiva es CHECK de SQL.
  @@map("kitchen_ticket_lines")
}

/// Medio de pago configurado para una sede.
model PaymentMethod {
  id         String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  locationId String            @map("location_id") @db.Uuid
  code       String            @db.VarChar(30)
  name       String            @db.VarChar(100)
  methodType PaymentMethodType @map("method_type")
  active     Boolean           @default(true)

  location Location  @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  payments Payment[]

  @@unique([locationId, code], map: "payment_methods_code_unique")
  @@map("payment_methods")
}

/// Caja física.
model CashRegister {
  id         String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  locationId String  @map("location_id") @db.Uuid
  code       String  @db.VarChar(30)
  name       String  @db.VarChar(100)
  active     Boolean @default(true)

  location Location      @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sessions CashSession[]

  @@unique([locationId, code], map: "cash_registers_code_unique")
  @@map("cash_registers")
}

/// Apertura y cierre de una caja por fecha comercial.
model CashSession {
  id                 String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  cashRegisterId     String            @map("cash_register_id") @db.Uuid
  businessDate       DateTime          @map("business_date") @db.Date
  openedByUserId     String            @map("opened_by_user_id") @db.Uuid
  closedByUserId     String?           @map("closed_by_user_id") @db.Uuid
  status             CashSessionStatus @default(Open)
  openingAmount      Decimal           @map("opening_amount") @default(0) @db.Decimal(14, 2)
  expectedCashAmount Decimal?         @map("expected_cash_amount") @db.Decimal(14, 2)
  countedCashAmount  Decimal?         @map("counted_cash_amount") @db.Decimal(14, 2)
  differenceAmount   Decimal?         @map("difference_amount") @db.Decimal(14, 2)
  openedAt           DateTime          @map("opened_at") @default(now()) @db.Timestamptz(3)
  closedAt           DateTime?         @map("closed_at") @db.Timestamptz(3)
  notes              String?           @db.Text

  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  openedBy     User         @relation("CashSessionOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  closedBy     User?        @relation("CashSessionClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  movements    CashMovement[]
  payments     Payment[]

  @@unique([cashRegisterId, businessDate], map: "cash_sessions_unique_open")
  @@index([cashRegisterId, businessDate], map: "cash_sessions_register_date_idx")
  /// Cierre, montos y estado son CHECK de SQL.
  @@map("cash_sessions")
}

/// Movimiento de caja.
model CashMovement {
  id            String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  cashSessionId String          @map("cash_session_id") @db.Uuid
  movementType  CashMovementType @map("movement_type")
  amount        Decimal         @db.Decimal(14, 2)
  reason        String?         @db.VarChar(200)
  createdByUserId String?       @map("created_by_user_id") @db.Uuid
  createdAt     DateTime        @map("created_at") @default(now()) @db.Timestamptz(3)

  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  creator     User?       @relation("CashMovementCreator", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  /// amount positivo es CHECK de SQL.
  @@map("cash_movements")
}

/// Pago perteneciente a exactamente un contexto.
model Payment {
  id                 String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId            String?       @map("order_id") @db.Uuid
  reservationId      String?       @map("reservation_id") @db.Uuid
  eventId            String?       @map("event_id") @db.Uuid
  paymentMethodId    String        @map("payment_method_id") @db.Uuid
  cashSessionId      String?       @map("cash_session_id") @db.Uuid
  amount             Decimal       @db.Decimal(14, 2)
  currency           String        @default("USD") @db.Char(3)
  status             PaymentStatus @default(Pending)
  externalReference  String?       @map("external_reference") @db.VarChar(160)
  receivedByUserId   String?       @map("received_by_user_id") @db.Uuid
  paidAt             DateTime?     @map("paid_at") @db.Timestamptz(3)
  notes              String?       @db.Text
  createdAt          DateTime      @map("created_at") @default(now()) @db.Timestamptz(3)

  order         Order?         @relation("OrderPayments", fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reservation   Reservation?   @relation("ReservationPayments", fields: [reservationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  event         Event?         @relation("EventPayments", fields: [eventId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  paymentMethod PaymentMethod  @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  cashSession   CashSession?   @relation(fields: [cashSessionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  receivedBy    User?          @relation("PaymentReceiver", fields: [receivedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  dtePayments   DteDocumentPayment[]

  @@index([orderId, paidAt], map: "payments_order_idx")
  @@index([eventId, paidAt], map: "payments_event_idx")
  @@index([reservationId, paidAt], map: "payments_reservation_idx")
  /// num_nonnulls(order_id, reservation_id, event_id) = 1 es CHECK SQL.
  @@map("payments")
}

/// Propina voluntaria separada de descuentos.
model Tip {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId         String    @unique(map: "tips_order_id_key") @map("order_id") @db.Uuid
  tipRate         Decimal   @map("tip_rate") @db.Decimal(7, 6)
  amount          Decimal   @db.Decimal(14, 2)
  status          TipStatus @default(Accepted)
  wasInformed     Boolean   @map("was_informed") @default(false)
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz(3)
  adjustedAt     DateTime? @map("adjusted_at") @db.Timestamptz(3)
  adjustedByUserId String?  @map("adjusted_by_user_id") @db.Uuid
  dueAt           DateTime? @map("due_at") @db.Timestamptz(3)
  distributedAt   DateTime? @map("distributed_at") @db.Timestamptz(3)
  notes           String?   @db.Text
  createdAt       DateTime  @map("created_at") @default(now()) @db.Timestamptz(3)

  order    Order          @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  adjustedBy User?        @relation("TipAdjuster", fields: [adjustedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  distributions TipDistribution[]

  /// El rango de tip_rate y coherencia de fechas se valida en SQL/aplicación.
  @@map("tips")
}

/// Distribución de propina a un empleado.
model TipDistribution {
  id           String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tipId        String                @map("tip_id") @db.Uuid
  employeeId   String                @map("employee_id") @db.Uuid
  amount       Decimal               @db.Decimal(14, 2)
  status       TipDistributionStatus @default(Pending)
  dueAt        DateTime              @map("due_at") @db.Timestamptz(3)
  paidAt       DateTime?             @map("paid_at") @db.Timestamptz(3)
  paidByUserId String?               @map("paid_by_user_id") @db.Uuid
  notes        String?               @db.Text

  tip      Tip      @relation(fields: [tipId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  paidBy   User?    @relation("TipPayout", fields: [paidByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([tipId, employeeId], map: "tip_distributions_employee_unique")
  /// amount y paid_at/status son CHECK/lógica de aplicación.
  @@map("tip_distributions")
}

/// Secuencia local para numeración de documentos DTE.
model DteSequence {
  id               String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  locationId       String  @map("location_id") @db.Uuid
  documentTypeCode String  @map("document_type_code") @db.VarChar(10)
  series           String? @db.VarChar(20)
  nextNumber       BigInt   @map("next_number") @default(1) @db.BigInt
  active           Boolean  @default(true)

  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([locationId, documentTypeCode, series], map: "dte_sequences_unique")
  /// next_number positivo es CHECK de SQL.
  @@map("dte_sequences")
}

/// Cabecera y snapshot de un DTE.
model DteDocument {
  id                   String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  locationId           String              @map("location_id") @db.Uuid
  orderId              String?             @map("order_id") @db.Uuid
  documentTypeCode     String              @map("document_type_code") @db.VarChar(10)
  status               DteStatus           @default(Draft)
  generationCode       String              @unique(map: "dte_documents_generation_code_key") @map("generation_code") @default(dbgenerated("uuidv4()")) @db.Uuid
  controlNumber        String?             @map("control_number") @db.VarChar(100)
  receptionStamp       String?             @map("reception_stamp") @db.VarChar(100)
  issueAt              DateTime            @map("issue_at") @db.Timestamptz(3)
  transmissionType     String              @map("transmission_type") @default("normal") @db.VarChar(30)
  receptorName         String?             @map("receptor_name") @db.VarChar(200)
  receptorDocumentType CustomerDocumentType? @map("receptor_document_type")
  receptorDocumentNumber String?            @map("receptor_document_number") @db.VarChar(80)
  receptorNrc          String?             @map("receptor_nrc") @db.VarChar(80)
  receptorAddress      String?             @map("receptor_address") @db.Text
  subtotalAmount       Decimal             @map("subtotal_amount") @default(0) @db.Decimal(14, 2)
  discountAmount       Decimal             @map("discount_amount") @default(0) @db.Decimal(14, 2)
  taxAmount            Decimal             @map("tax_amount") @default(0) @db.Decimal(14, 2)
  totalAmount          Decimal             @map("total_amount") @default(0) @db.Decimal(14, 2)
  signedDteJson        Json?               @map("signed_dte_json") @db.JsonB
  readableDocument     String?             @map("readable_document") @db.Text
  errorMessage         String?             @map("error_message") @db.Text
  createdAt            DateTime            @map("created_at") @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime            @map("updated_at") @default(now()) @db.Timestamptz(3)

  location       Location              @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  order          Order?                @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lines          DteDocumentLine[]
  payments       DteDocumentPayment[]
  events         DteEvent[]

  @@index([locationId, issueAt, status], map: "dte_documents_location_date_idx")
  /// generation_code es UUIDv4 y la unicidad parcial del sello son SQL/lógica fiscal.
  /// El documento aceptado se trata como snapshot inmutable por la aplicación.
  @@map("dte_documents")
}

/// Línea fiscal congelada de un DTE.
model DteDocumentLine {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  dteDocumentId     String   @map("dte_document_id") @db.Uuid
  sourceOrderLineId String?  @map("source_order_line_id") @db.Uuid
  lineNumber        Int      @map("line_number")
  description       String   @db.VarChar(250)
  quantity          Decimal  @db.Decimal(14, 6)
  unitPrice         Decimal  @map("unit_price") @db.Decimal(14, 2)
  discountAmount    Decimal  @map("discount_amount") @default(0) @db.Decimal(14, 2)
  taxRate           Decimal  @map("tax_rate") @default(0) @db.Decimal(7, 6)
  taxableAmount     Decimal  @map("taxable_amount") @db.Decimal(14, 2)
  taxAmount         Decimal  @map("tax_amount") @db.Decimal(14, 2)
  lineTotal         Decimal  @map("line_total") @db.Decimal(14, 2)

  dteDocument   DteDocument @relation(fields: [dteDocumentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sourceOrderLine OrderLine? @relation(fields: [sourceOrderLineId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([dteDocumentId, lineNumber], map: "dte_document_lines_unique")
  /// Coherencia de importes y cantidades es CHECK de SQL.
  @@map("dte_document_lines")
}

/// Forma de pago declarada en un DTE.
model DteDocumentPayment {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  dteDocumentId     String   @map("dte_document_id") @db.Uuid
  paymentId         String?  @map("payment_id") @db.Uuid
  paymentMethodCode String   @map("payment_method_code") @db.VarChar(40)
  amount            Decimal  @db.Decimal(14, 2)
  currency          String   @default("USD") @db.Char(3)

  dteDocument DteDocument @relation(fields: [dteDocumentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  payment     Payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  /// amount y currency se validan con CHECK de SQL.
  @@map("dte_document_payments")
}

/// Evento de transmisión o cambio de estado de un DTE.
model DteEvent {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  dteDocumentId  String       @map("dte_document_id") @db.Uuid
  eventType      DteEventType @map("event_type")
  status         String       @db.VarChar(20)
  occurredAt     DateTime     @map("occurred_at") @default(now()) @db.Timestamptz(3)
  requestJson    Json?        @map("request_json") @db.JsonB
  responseJson   Json?        @map("response_json") @db.JsonB
  errorMessage   String?      @map("error_message") @db.Text

  dteDocument DteDocument @relation(fields: [dteDocumentId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  /// status es CHECK de SQL.
  @@map("dte_events")
}

/// Alérgeno revisado para una variante vendible.
model MenuItemAllergen {
  menuItemVariantId String   @map("menu_item_variant_id") @db.Uuid
  allergenId        String   @map("allergen_id") @db.Uuid
  presenceType      String   @map("presence_type") @db.VarChar(20)
  isReviewed        Boolean  @map("is_reviewed") @default(false)
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewedByUserId  String?  @map("reviewed_by_user_id") @db.Uuid

  variant   MenuItemVariant @relation(fields: [menuItemVariantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  allergen  Allergen        @relation(fields: [allergenId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reviewedBy User?          @relation("MenuItemAllergenReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@id([menuItemVariantId, allergenId])
  /// presence_type y revisión son CHECK/lógica de aplicación.
  @@map("menu_item_allergens")
}

/// Mensaje recibido desde el formulario público.
model ContactMessage {
  id                 String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  locationId         String                @map("location_id") @db.Uuid
  customerId         String?               @map("customer_id") @db.Uuid
  reservationId      String?               @map("reservation_id") @db.Uuid
  eventId            String?               @map("event_id") @db.Uuid
  nameSnapshot       String                @map("name_snapshot") @db.VarChar(200)
  email              String                @db.VarChar(200)
  phone              String?               @db.VarChar(40)
  languageCode       String                @map("language_code") @default("es") @db.Char(2)
  topic              String                @db.VarChar(30)
  message            String                @db.Text
  status             ContactMessageStatus  @default(New)
  assignedToUserId   String?               @map("assigned_to_user_id") @db.Uuid
  receivedAt         DateTime              @map("received_at") @default(now()) @db.Timestamptz(3)
  repliedAt          DateTime?             @map("replied_at") @db.Timestamptz(3)

  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  reservation  Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  assignedTo   User?        @relation("ContactMessageAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  /// language_code y topic son CHECK de SQL.
  @@map("contact_messages")
}

/// Libro mayor de inventario.
model InventoryMovement {
  id                 String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  storageLocationId  String                 @map("storage_location_id") @db.Uuid
  ingredientId       String                 @map("ingredient_id") @db.Uuid
  inventoryLotId     String?                @map("inventory_lot_id") @db.Uuid
  movementType       InventoryMovementType  @map("movement_type")
  quantityDelta      Decimal                @map("quantity_delta") @db.Decimal(14, 6)
  unitCost           Decimal                @map("unit_cost") @default(0) @db.Decimal(14, 6)
  goodsReceiptLineId String?                @map("goods_receipt_line_id") @db.Uuid
  orderLineId        String?                @map("order_line_id") @db.Uuid
  createdByUserId    String?                @map("created_by_user_id") @db.Uuid
  reason             String?                @db.VarChar(200)
  createdAt          DateTime               @map("created_at") @default(now()) @db.Timestamptz(3)

  storageLocation  StorageLocation  @relation(fields: [storageLocationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  ingredient       Ingredient       @relation(fields: [ingredientId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  inventoryLot     InventoryLot?    @relation(fields: [inventoryLotId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  goodsReceiptLine GoodsReceiptLine? @relation(fields: [goodsReceiptLineId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  orderLine        OrderLine?       @relation(fields: [orderLineId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdBy        User?            @relation("InventoryMovementCreator", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([storageLocationId, ingredientId, createdAt], map: "inventory_movements_stock_idx")
  /// La fuente válida de cada movimiento se impone con CHECK de SQL.
  /// Las vistas inventory_balance y daily_sales son SQL-only y se omiten del cliente Prisma.
  @@map("inventory_movements")
}
