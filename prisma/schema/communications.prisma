// Contacto y notificaciones

enum ContactMessageStatus {
  New        @map("new")
  InProgress @map("in_progress")
  Replied    @map("replied")
  Closed     @map("closed")
  Spam       @map("spam")

  @@map("contact_message_status")
}

enum NotificationType {
  LowStock         @map("low_stock")
  LotExpiring      @map("lot_expiring")
  SupplierReminder @map("supplier_reminder")
  MaintenanceDue   @map("maintenance_due")
  ReservationNew   @map("reservation_new")
  ContactMessage   @map("contact_message")
  BackupSuccess    @map("backup_success")
  BackupFailed     @map("backup_failed")
  SecurityAlert    @map("security_alert")
  System           @map("system")

  @@map("notification_type")
}

enum NotificationSeverity {
  Info    @map("info")
  Warning @map("warning")
  Error   @map("error")
  Success @map("success")

  @@map("notification_severity")
}

model ContactMessage {
  id                 String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  locationId         String                @map("location_id") @db.Uuid
  customerId         String?               @map("customer_id") @db.Uuid
  reservationId      String?               @map("reservation_id") @db.Uuid
  eventId            String?               @map("event_id") @db.Uuid
  nameSnapshot       String                @map("name_snapshot") @db.VarChar(200)
  email              String                @db.VarChar(200)
  phone              String?               @db.VarChar(40)
  languageCode       String                @map("language_code") @default("es") @db.Char(2)
  topic              String                @db.VarChar(30)
  message            String                @db.Text
  status             ContactMessageStatus  @default(New)
  assignedToUserId   String?               @map("assigned_to_user_id") @db.Uuid
  receivedAt         DateTime              @map("received_at") @default(now()) @db.Timestamptz(3)
  repliedAt          DateTime?             @map("replied_at") @db.Timestamptz(3)
  archivedAt         DateTime?             @map("archived_at") @db.Timestamptz(3)
  archivedByUserId   String?               @map("archived_by_user_id") @db.Uuid

  location     Location     @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  reservation  Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  assignedTo   User?        @relation("ContactMessageAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  archivedBy   User?        @relation("ContactMessageArchiver", fields: [archivedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([locationId, status, receivedAt], map: "contact_messages_location_status_received_idx")
  @@index([locationId, receivedAt], map: "contact_messages_location_received_idx")
  /// language_code y topic son CHECK de SQL.
  @@map("contact_messages")
}

/// Libro mayor de inventario.

model Notification {
  id                String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  recipientUserId   String?              @map("recipient_user_id") @db.Uuid
  recipientRoleCode String?              @map("recipient_role_code") @db.VarChar(40)
  notificationType  NotificationType     @map("notification_type")
  severity          NotificationSeverity
  title             String               @db.VarChar(200)
  body              String               @db.Text
  internalLink      String?              @map("internal_link") @db.VarChar(500)
  readAt            DateTime?            @map("read_at") @db.Timestamptz(3)
  archived          Boolean              @default(false)
  createdAt         DateTime             @map("created_at") @default(now()) @db.Timestamptz(3)

  recipientUser User? @relation(fields: [recipientUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([recipientUserId, readAt, archived, createdAt], map: "notifications_user_unread_idx")
  @@index([recipientRoleCode, readAt, archived, createdAt], map: "notifications_role_unread_idx")
  @@index([notificationType, createdAt], map: "notifications_type_idx")
  @@index([severity, createdAt], map: "notifications_severity_idx")
  @@map("notifications")
}

