// Respaldos, recursos y compras

enum BackupType {
  Database @map("database")
  Uploads  @map("uploads")
  Full     @map("full")

  @@map("backup_type")
}

enum BackupStatus {
  Pending   @map("pending")
  Running   @map("running")
  Succeeded @map("succeeded")
  Failed    @map("failed")
  Expired   @map("expired")

  @@map("backup_status")
}

enum ResourceCategory {
  Equipment    @map("equipment")
  Furniture    @map("furniture")
  Supplies     @map("supplies")
  Kitchenware  @map("kitchenware")
  Electronics  @map("electronics")
  Other        @map("other")

  @@map("resource_category")
}

enum ResourceStatus {
  Operational  @map("operational")
  Maintenance  @map("maintenance")
  Broken       @map("broken")
  Retired      @map("retired")

  @@map("resource_status")
}

enum PurchaseOrderStatus {
  Draft     @map("draft")
  Submitted @map("submitted")
  Approved  @map("approved")
  Received  @map("received")
  Cancelled @map("cancelled")

  @@map("purchase_order_status")
}

/// Alta inicial del propietario. La fila única (id = 1) y el CHECK SQL impiden repetirla.

model BackupJob {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type         BackupType
  status       BackupStatus @default(Pending)
  sizeBytes    BigInt?      @map("size_bytes") @db.BigInt
  checksum     String?      @db.Char(64)
  storageKey   String?      @map("storage_key") @db.VarChar(500)
  expiresAt    DateTime?    @map("expires_at") @db.Timestamptz(3)
  actorUserId  String?      @map("actor_user_id") @db.Uuid
  startedAt    DateTime?    @map("started_at") @db.Timestamptz(3)
  completedAt  DateTime?    @map("completed_at") @db.Timestamptz(3)
  errorMessage String?      @map("error_message") @db.Text
  createdAt    DateTime     @map("created_at") @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @map("updated_at") @default(now()) @db.Timestamptz(3)

  actor User? @relation("BackupJobActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([status, createdAt], map: "backup_jobs_status_created_idx")
  @@index([expiresAt], map: "backup_jobs_expires_idx")
  @@map("backup_jobs")
}

/// Estación operativa de preparación o despacho.

model Resource {
  id           String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  locationId   String           @map("location_id") @db.Uuid
  resourceCode String           @map("resource_code") @db.VarChar(40)
  name         String           @db.VarChar(200)
  category     ResourceCategory
  location     String?          @db.VarChar(200)
  status       ResourceStatus   @default(Operational)
  purchaseDate DateTime?        @map("purchase_date") @db.Date
  cost         Decimal?         @db.Decimal(14, 2)
  supplierId   String?          @map("supplier_id") @db.Uuid
  notes        String?          @db.Text
  active       Boolean          @default(true)
  createdAt    DateTime         @map("created_at") @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @map("updated_at") @default(now()) @db.Timestamptz(3)

  siteLocation  Location                      @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  supplier      Supplier?                     @relation(fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  schedules     ResourceMaintenanceSchedule[]

  @@unique([locationId, resourceCode], map: "resources_code_unique")
  @@map("resources")
}

/// Mantenimientos programados de recursos.

model ResourceMaintenanceSchedule {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  resourceId        String    @map("resource_id") @db.Uuid
  scheduledDate     DateTime  @map("scheduled_date") @db.Date
  description       String    @db.Text
  completed         Boolean   @default(false)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(3)
  completedByUserId String?   @map("completed_by_user_id") @db.Uuid
  notes             String?   @db.Text
  createdAt         DateTime  @map("created_at") @default(now()) @db.Timestamptz(3)

  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  completedBy User?    @relation("MaintenanceCompleter", fields: [completedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([resourceId, scheduledDate], map: "resource_maintenance_resource_date_idx")
  @@index([completed, scheduledDate], map: "resource_maintenance_pending_idx")
  @@map("resource_maintenance_schedules")
}

/// Órdenes de compra a proveedores.

model PurchaseOrder {
  id                String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  locationId        String              @map("location_id") @db.Uuid
  supplierId        String              @map("supplier_id") @db.Uuid
  orderNumber       String              @map("order_number") @db.VarChar(80)
  orderDate         DateTime            @map("order_date") @db.Date
  expectedDelivery  DateTime?           @map("expected_delivery") @db.Date
  status            PurchaseOrderStatus @default(Draft)
  totalAmount       Decimal             @map("total_amount") @db.Decimal(14, 2)
  notes             String?             @db.Text
  createdByUserId   String              @map("created_by_user_id") @db.Uuid
  approvedByUserId  String?             @map("approved_by_user_id") @db.Uuid
  approvedAt        DateTime?           @map("approved_at") @db.Timestamptz(3)
  createdAt         DateTime            @map("created_at") @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @map("updated_at") @default(now()) @db.Timestamptz(3)

  location     Location             @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  supplier     Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdBy    User                 @relation("PurchaseOrderCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  approvedBy   User?                @relation("PurchaseOrderApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  lines        PurchaseOrderLine[]

  @@unique([locationId, orderNumber], map: "purchase_orders_number_unique")
  @@index([supplierId, orderDate], map: "purchase_orders_supplier_date_idx")
  @@index([status, orderDate], map: "purchase_orders_status_date_idx")
  @@map("purchase_orders")
}

/// Líneas de órdenes de compra.

model PurchaseOrderLine {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  purchaseOrderId String    @map("purchase_order_id") @db.Uuid
  ingredientId    String    @map("ingredient_id") @db.Uuid
  unitId          String    @map("unit_id") @db.Uuid
  quantityOrdered Decimal   @map("quantity_ordered") @db.Decimal(14, 6)
  unitCost        Decimal   @map("unit_cost") @db.Decimal(14, 6)
  totalCost       Decimal   @map("total_cost") @db.Decimal(14, 2)
  quantityReceived Decimal? @map("quantity_received") @db.Decimal(14, 6)
  receivedAt      DateTime? @map("received_at") @db.Timestamptz(3)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  unit          Unit          @relation("PurchaseOrderLineUnit", fields: [unitId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([purchaseOrderId, receivedAt], map: "purchase_order_lines_received_idx")
  @@map("purchase_order_lines")
}

