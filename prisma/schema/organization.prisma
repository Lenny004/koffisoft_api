// Negocio, sucursales, SEO y anuncios

enum PublicationStatus {
  Draft     @map("draft")
  Scheduled @map("scheduled")
  Published @map("published")

  @@map("publication_status")
}

model SystemSetup {
  id          Int      @id @db.SmallInt
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz(3)
  ownerUserId String   @unique(map: "system_setups_owner_user_id_key") @map("owner_user_id") @db.Uuid

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("system_setups")
}

/// Identidad legal, comercial y fiscal del negocio.

model Business {
  id                   String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  legalName            String   @map("legal_name") @db.VarChar(200)
  tradeName            String   @map("trade_name") @db.VarChar(200)
  taxId                String   @map("tax_id") @db.VarChar(40)
  nrc                  String?  @db.VarChar(40)
  economicActivityCode String?  @map("economic_activity_code") @db.VarChar(40)
  addressLine          String   @map("address_line") @db.Text
  municipality         String   @db.VarChar(120)
  department           String   @db.VarChar(120)
  phone                String?  @db.VarChar(40)
  email                String?  @db.VarChar(200)
  countryCode          String   @map("country_code") @default("SV") @db.Char(2)
  baseCurrency         String   @map("base_currency") @default("USD") @db.Char(3)
  timezone             String   @default("America/El_Salvador") @db.VarChar(64)
  dteEnvironment       String   @map("dte_environment") @default("test") @db.VarChar(20)
  dteEnabled           Boolean  @map("dte_enabled") @default(false)
  dteCertificateRef    String?  @map("dte_certificate_ref") @db.Text
  dtePrivateKeyRef     String?  @map("dte_private_key_ref") @db.Text
  active               Boolean  @default(true)
  createdAt            DateTime @map("created_at") @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @map("updated_at") @default(now()) @db.Timestamptz(3)

  locations Location[]
  roles     Role[]
  siteProfile BusinessSiteProfile?
  seoMetadata SeoMetadata[]
  pageViews PageView[]

  /// La fecha de actualización real la mantiene el trigger SQL set_updated_at.
  @@map("businesses")
}

/// Contenido editorial compartido por las sedes de un negocio.

model BusinessSiteProfile {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId          String   @unique(map: "business_site_profiles_business_id_key") @map("business_id") @db.Uuid
  heroEyebrow         String   @map("hero_eyebrow") @db.VarChar(120)
  heroTitle           String   @map("hero_title") @db.VarChar(160)
  heroDescription     String   @map("hero_description") @db.Text
  heroImageUrl        String?  @map("hero_image_url") @db.VarChar(500)
  aboutTitle          String   @map("about_title") @db.VarChar(160)
  aboutDescription    String   @map("about_description") @db.Text
  aboutMission        String   @map("about_mission") @db.Text
  aboutVision         String   @map("about_vision") @db.Text
  aboutTeam           Json     @map("about_team") @db.JsonB
  socialFacebookUrl   String?  @map("social_facebook_url") @db.VarChar(500)
  socialInstagramUrl  String?  @map("social_instagram_url") @db.VarChar(500)
  socialTikTokUrl     String?  @map("social_tiktok_url") @db.VarChar(500)
  createdAt           DateTime @map("created_at") @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @map("updated_at") @default(now()) @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  /// La fecha de actualización real la mantiene el trigger SQL set_updated_at.
  @@map("business_site_profiles")
}

/// Metadatos SEO editables por recurso, con alcance de negocio o sede.

model SeoMetadata {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId      String?  @map("business_id") @db.Uuid
  locationId      String?  @map("location_id") @db.Uuid
  resourceType    String   @map("resource_type") @db.VarChar(30)
  resourceKey     String   @map("resource_key") @db.VarChar(160)
  metaTitle       String   @map("meta_title") @db.VarChar(70)
  metaDescription String   @map("meta_description") @db.VarChar(160)
  ogImageUrl      String?  @map("og_image_url") @db.VarChar(500)
  canonicalUrl    String?  @map("canonical_url") @db.VarChar(500)
  noindex         Boolean  @default(false)
  createdAt       DateTime @map("created_at") @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @map("updated_at") @default(now()) @db.Timestamptz(3)

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([businessId, resourceType], map: "seo_metadata_business_type_idx")
  @@index([locationId, resourceType], map: "seo_metadata_location_type_idx")
  /// La unicidad con NULL se garantiza con un índice de expresiones en SQL.
  @@map("seo_metadata")
}

/// Sede operativa y zona horaria de los servicios.

model Location {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId    String   @map("business_id") @db.Uuid
  code          String   @db.VarChar(30)
  name          String   @db.VarChar(150)
  addressLine   String   @map("address_line") @db.Text
  municipality  String   @db.VarChar(120)
  department    String   @db.VarChar(120)
  countryCode   String   @map("country_code") @default("SV") @db.Char(2)
  phone         String?  @db.VarChar(40)
  email         String?  @db.VarChar(200)
  latitude      Decimal? @db.Decimal(9, 6)
  longitude     Decimal? @db.Decimal(9, 6)
  timezone      String   @default("America/El_Salvador") @db.VarChar(64)
  active        Boolean  @default(true)
  createdAt     DateTime @map("created_at") @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @map("updated_at") @default(now()) @db.Timestamptz(3)

  business              Business              @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  locationHours         LocationHour[]
  hourOverrides         LocationHourOverride[]
  employees             Employee[]
  shifts                Shift[]
  prepStations          PrepStation[]
  menuCategories        MenuCategory[]
  menuPrices            MenuPrice[]
  menuAvailabilities    MenuAvailability[]
  menuItemOutages       MenuItemOutage[]
  modifierGroups        ModifierGroup[]
  promotions            Promotion[]
  importantAnnouncements ImportantAnnouncement[]
  suppliers             Supplier[]
  storageLocations      StorageLocation[]
  venueSpaces           VenueSpace[]
  reservations          Reservation[]
  events                Event[]
  eventPackages         EventPackage[]
  goodsReceipts         GoodsReceipt[]
  orders                Order[]
  paymentMethods        PaymentMethod[]
  cashRegisters         CashRegister[]
  dteSequences          DteSequence[]
  dteDocuments          DteDocument[]
  contactMessages       ContactMessage[]
  seoMetadata            SeoMetadata[]
  pageViews              PageView[]
  resources              Resource[]
  purchaseOrders         PurchaseOrder[]

  @@unique([businessId, code], map: "locations_code_unique")
  /// Los límites de latitud y longitud son CHECK exclusivos de SQL.
  @@map("locations")
}

/// Aviso editorial que puede publicarse temporalmente en la portada pública.

model ImportantAnnouncement {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  locationId   String   @map("location_id") @db.Uuid
  title        String   @db.VarChar(160)
  message      String   @db.Text
  ctaLabel     String?  @map("cta_label") @db.VarChar(80)
  ctaUrl       String?  @map("cta_url") @db.VarChar(500)
  startsAt     DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime? @map("ends_at") @db.Timestamptz(3)
  publicationStatus PublicationStatus @default(Draft) @map("publication_status")
  publishedAt       DateTime?         @map("published_at") @db.Timestamptz(3)
  scheduledAt       DateTime?         @map("scheduled_at") @db.Timestamptz(3)
  expiresAt         DateTime?         @map("expires_at") @db.Timestamptz(3)
  previewTokenHash  String?           @unique(map: "important_announcements_preview_token_unique") @map("preview_token_hash") @db.Char(64)
  previewExpiresAt  DateTime?         @map("preview_expires_at") @db.Timestamptz(3)
  displayOrder Int      @map("display_order") @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @map("created_at") @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @map("updated_at") @default(now()) @db.Timestamptz(3)

  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([locationId, active, displayOrder], map: "important_announcements_public_idx")
  @@index([locationId, publicationStatus, scheduledAt], map: "important_announcements_publication_idx")
  @@map("important_announcements")
}

/// Horario recurrente por día y tipo de servicio.

model LocationHour {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  locationId     String   @map("location_id") @db.Uuid
  serviceType    String   @map("service_type") @db.VarChar(30)
  dayOfWeek      Int      @map("day_of_week") @db.SmallInt
  opensAt        DateTime @map("opens_at") @db.Time(6)
  closesAt       DateTime @map("closes_at") @db.Time(6)
  crossesMidnight Boolean  @map("crosses_midnight") @default(false)
  active         Boolean  @default(true)

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([locationId, serviceType, dayOfWeek, opensAt], map: "location_hours_unique")
  /// service_type, día y coherencia horaria se validan con CHECK en SQL.
  @@map("location_hours")
}

/// Excepción de horario para una fecha concreta.

model LocationHourOverride {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  locationId  String   @map("location_id") @db.Uuid
  serviceDate DateTime @map("service_date") @db.Date
  serviceType String   @map("service_type") @db.VarChar(30)
  opensAt     DateTime? @map("opens_at") @db.Time(6)
  closesAt    DateTime? @map("closes_at") @db.Time(6)
  isClosed    Boolean   @map("is_closed") @default(false)
  reason      String    @db.Text
  createdAt   DateTime  @map("created_at") @default(now()) @db.Timestamptz(3)

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([locationId, serviceDate, serviceType], map: "location_hour_overrides_unique")
  /// La coherencia entre is_closed, opens_at y closes_at es CHECK de SQL.
  @@map("location_hour_overrides")
}

/// Persona que trabaja en una sede y su puesto operativo.

model PageView {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId      String   @map("business_id") @db.Uuid
  locationId      String?  @map("location_id") @db.Uuid
  path            String   @db.VarChar(500)
  resourceType    String   @map("resource_type") @db.VarChar(30)
  resourceKey     String?  @map("resource_key") @db.VarChar(160)
  refererHost     String?  @map("referer_host") @db.VarChar(255)
  occurredAt      DateTime @map("occurred_at") @db.Date
  userAgentFamily String?  @map("user_agent_family") @db.VarChar(80)
  aggregateKey    String   @unique(map: "page_views_aggregate_key_unique") @map("aggregate_key") @db.Char(64)
  viewCount       Int      @default(1) @map("view_count")
  createdAt       DateTime @map("created_at") @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @map("updated_at") @default(now()) @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([businessId, occurredAt], map: "page_views_business_date_idx")
  @@index([locationId, occurredAt], map: "page_views_location_date_idx")
  @@index([path, occurredAt], map: "page_views_path_date_idx")
  @@index([resourceType, resourceKey, occurredAt], map: "page_views_resource_date_idx")
  @@index([refererHost, occurredAt], map: "page_views_referer_date_idx")
  /// La retencion de 395 dias y la ausencia de IP/cookies se aplican en el servicio.
  @@map("page_views")
}

/// Notificaciones del sistema y alertas operativas.
